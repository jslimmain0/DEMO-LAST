# 루트 레벨 가드 (backend/·frontend/ 는 각자 .gitignore 로 산출물 커버)
node_modules/
*.log

# 개발 중 생기는 아티팩트 (재유입 차단)
.thumbnail
uploads/

# 루트에 npm 프로젝트 없음 — stray lockfile 재유입 차단
/package-lock.json

# 배포 로컬 오버라이드(비밀 포함 가능) — .env.example 만 커밋
infra/.env
.env

# 앱 런타임 산출물(PID/로그)
.run/

# 멀티에이전트 프로젝트 평가 문서 — 커밋 제외(로컬 전용)
docs/flowlink-user-critique.md
site/
