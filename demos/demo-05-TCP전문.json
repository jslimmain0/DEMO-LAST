{
  "name": "데모 05 — TCP 고정길이 전문 (BAL1 잔액조회·IF)",
  "nodes": [
    { "id": "start001", "name": "시작", "type": "start", "cat": "start", "x": 40, "y": 200 },
    {
      "id": "tcpbal01", "name": "잔액조회 전문", "type": "tcp", "cat": "tcp", "x": 260, "y": 200,
      "tcpHost": "127.0.0.1", "tcpPort": 9091, "tcpEncoding": "EUC-KR", "tcpTimeoutMs": 5000,
      "tcpPrefixLength": 4, "tcpPrefixIncludesSelf": false,
      "tcpRequest": [
        { "id": "t1", "name": "txCode", "length": 4, "value": "BAL1", "pad": "right", "padChar": " " },
        { "id": "t2", "name": "acctNo", "length": 12, "value": "110123456789", "pad": "right", "padChar": " " }
      ],
      "tcpResponse": [
        { "id": "r1", "name": "resultCode", "length": 2 },
        { "id": "r2", "name": "balance", "length": 12 },
        { "id": "r3", "name": "custName", "length": 10 }
      ],
      "outputs": [
        { "key": "resultCode", "type": "string" },
        { "key": "balance", "type": "string" },
        { "key": "custName", "type": "string" }
      ]
    },
    {
      "id": "if000001", "name": "정상 응답?", "type": "if", "cat": "if", "x": 480, "y": 200,
      "condition": "{{ resultCode@tcpbal01 }} == '00'"
    },
    {
      "id": "setok001", "name": "조회 성공", "type": "set", "cat": "set", "x": 700, "y": 110,
      "vars": [
        { "id": "v1", "key": "고객명", "bound": { "key": "custName", "sourceId": "tcpbal01", "nodeName": "잔액조회 전문" }, "secret": false },
        { "id": "v2", "key": "잔액", "bound": { "key": "balance", "sourceId": "tcpbal01", "nodeName": "잔액조회 전문" }, "secret": false }
      ]
    },
    {
      "id": "setfail1", "name": "조회 실패", "type": "set", "cat": "set", "x": 700, "y": 300,
      "vars": [ { "id": "v1", "key": "failMsg", "value": "전문 응답 코드가 00이 아닙니다", "secret": false } ]
    },
    { "id": "end00001", "name": "끝", "type": "end", "cat": "end", "x": 920, "y": 200 }
  ],
  "edges": [
    { "id": "e1", "from": "start001", "to": "tcpbal01" },
    { "id": "e2", "from": "tcpbal01", "to": "if000001" },
    { "id": "e3", "from": "if000001", "fromPort": "true", "to": "setok001" },
    { "id": "e4", "from": "if000001", "fromPort": "false", "to": "setfail1" },
    { "id": "e5", "from": "setok001", "to": "end00001" },
    { "id": "e6", "from": "setfail1", "to": "end00001" }
  ]
}
