# deploy/docker-compose.yml 오버라이드 예시 — 이 파일을 deploy/.env 로 복사해 값을 채우면 자동 적용된다.
# (docker compose 는 compose 파일과 같은 디렉터리의 .env 를 읽는다: docker compose -f deploy/docker-compose.yml ...)
#
# 값을 하나도 안 주면 전부 localhost 기본값 → 개발 PC 단독 실행에 그대로 동작한다.
# 사내 공유 서버(예: http://flowlink.corp:18080)에 올릴 때만 아래를 채운다.

# 브라우저가 접속하는 앱 오리진 — Keycloak redirectUris·CORS·post-logout 에 반영
# 예: http://flowlink.corp:18080
FLOWLINK_APP_ORIGIN=http://localhost:18080

# (선택) vite dev 서버를 별도로 띄워 붙일 때의 오리진 — 단일 jar 배포만 쓰면 불필요
FLOWLINK_WEB_ORIGIN=http://localhost:5173

# 브라우저가 접속하는 Keycloak 공개 주소 — 토큰 iss·issuer-uri 와 일치해야 한다
# 예: http://flowlink.corp:8081
KC_PUBLIC_URL=http://localhost:8081

# RunState 스냅샷(AES-GCM) 암호키 — 운영 배포 시 반드시 강한 값으로 교체
FLOWLINK_STATE_SECRET=change-me-to-a-strong-secret

# Keycloak 관리자 계정(초기 부트스트랩)
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin
