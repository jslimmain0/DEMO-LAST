# infra/docker-compose.yml 오버라이드 예시 — 이 파일을 infra/.env 로 복사해 값을 채우면 자동 적용된다.
# (docker compose 는 compose 파일과 같은 디렉터리의 .env 를 읽는다: docker compose -f infra/docker-compose.yml ...)
#
# 값을 하나도 안 주면 전부 기본값(dev)으로 동작한다. 운영에선 반드시 교체.

# --- Vault (docker) ---
# dev 모드 루트 토큰 id — 앱의 FLOWLINK_VAULT_TOKEN 과 같은 값을 써야 앱이 시크릿을 읽는다.
VAULT_TOKEN=flowlink-root

# --- (선택) 로컬 Oracle: docker compose ... --profile oracle up ---
# 운영은 사내/별도 서버 Oracle 로 붙이므로 아래는 로컬 테스트용. 앱은 FLOWLINK_DB_URL 로 그쪽을 가리킨다.
ORACLE_ADMIN_PASSWORD=admin
FLOWLINK_DB_USER=flowlink
FLOWLINK_DB_PASSWORD=flowlink

# ─────────────────────────────────────────────────────────────────────────────
# 참고: 메인 앱(flowlink.jar)은 도커가 아니라 서버(EC2)에서 scripts/start.sh 로 뜬다.
# 앱 프로세스 쪽 env(도커 아님)로 인증·Vault·DB 를 준다:
#   FLOWLINK_AUTH_GITHUB_ENABLED=true          # GitHub 로그인(운영)
#   FLOWLINK_AUTH_JWT_SECRET=<강한 시크릿>
#   FLOWLINK_VAULT_ENABLED=true
#   FLOWLINK_VAULT_ADDRESS=http://<vault호스트>:8200
#   FLOWLINK_VAULT_TOKEN=<VAULT_TOKEN 과 동일>
#   SPRING_PROFILES_ACTIVE=oracle
#   FLOWLINK_DB_URL=jdbc:oracle:thin:@//<oracle호스트>:1521/FREEPDB1
# ─────────────────────────────────────────────────────────────────────────────
