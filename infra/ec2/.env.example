# Real EC2: copy to /opt/flowlink/.env, chmod 600, fill values. Never commit secrets.
# Docker lab start script generates a separate persistent H2 configuration.
SPRING_PROFILES_ACTIVE=dev
FLOWLINK_SITE_ADDRESS=flowlink.example.internal
FLOWLINK_PUBLIC_URL=https://flowlink.example.internal
FLOWLINK_PUBLIC_MCP_URL=https://flowlink.example.internal/mcp
FLOWLINK_AUTH_GITHUB_ENABLED=true
FLOWLINK_AUTH_GUEST_ENABLED=false
FLOWLINK_AUTH_MOCK_LOGIN=false
FLOWLINK_AUTH_CLIENT_ID=replace-with-company-github-app-client-id
FLOWLINK_AUTH_JWT_SECRET=replace-with-a-persistent-random-secret
FLOWLINK_EXECUTION_STATE_SECRET=replace-with-a-persistent-random-secret
FLOWLINK_DB_URL=jdbc:oracle:thin:@//oracle.example.internal:1521/FREEPDB1
FLOWLINK_DB_USER=flowlink
FLOWLINK_DB_PASSWORD=replace-with-database-password
FLOWLINK_VAULT_ENABLED=true
FLOWLINK_VAULT_ADDRESS=https://vault.example.internal
FLOWLINK_VAULT_APPROLE_ROLE_ID=replace-with-role-id
FLOWLINK_VAULT_APPROLE_SECRET_ID=replace-with-secret-id
FLOWLINK_VAULT_TRANSIT_ENABLED=true
FLOWLINK_VAULT_TRANSIT_MOUNT=transit
FLOWLINK_VAULT_TRANSIT_KEY=flowlink
FLOWLINK_PLUGINS_DIR=/home/flowlink/plugins
SPRING_H2_CONSOLE_ENABLED=false
